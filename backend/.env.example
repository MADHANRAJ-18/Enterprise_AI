# Server Configuration
PORT=8000
ENVIRONMENT=development

# LLM Provider Configuration (gemini or groq)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.7
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TIMEOUT_SECONDS=45

# Supabase Credentials (Database & Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_BUCKET=enterprise-documents

# Embeddings & FAISS Vector Index
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
FAISS_INDEX_PATH=faiss_index
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# RAG Search Tuning
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3
RAG_MAX_CHUNKS_PER_DOC=3

# Email Notifications (Optional: smtp, sendgrid, or resend)
EMAIL_PROVIDER=smtp
EMAIL_FROM=Enterprise AI <notifications@enterprise-ai.internal>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true
